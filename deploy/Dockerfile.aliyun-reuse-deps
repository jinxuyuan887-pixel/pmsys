FROM pmsys:657ef9e-20260803

WORKDIR /app

# This release does not change package.json or package-lock.json, so reuse the
# dependency layer already running in production and replace application code only.
RUN find /app -mindepth 1 -maxdepth 1 ! -name node_modules ! -name package.json ! -name package-lock.json -exec rm -rf {} +
COPY . .

ARG NEXT_PUBLIC_BASE_PATH=/pmsys
ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}
ENV HOST=0.0.0.0
ENV PORT=3000
ENV NODE_ENV=production

RUN ./node_modules/.bin/vinext build

EXPOSE 3000
CMD ["npm", "run", "start"]
